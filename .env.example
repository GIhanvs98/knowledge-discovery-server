# ==============================================================================
# Discovery Server Environment Configuration Template
# ==============================================================================

# Server Configuration
SERVER_PORT=8761
SPRING_APPLICATION_NAME=discovery-server

# Eureka Server Standalone Configuration
EUREKA_HOSTNAME=localhost
EUREKA_REGISTER_WITH_EUREKA=false
EUREKA_FETCH_REGISTRY=false
EUREKA_SERVICE_URL=http://localhost:8761/eureka/
EUREKA_ENABLE_SELF_PRESERVATION=false
EUREKA_EVICTION_INTERVAL_TIMER_IN_MS=10000

# Actuator & Observability
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always
